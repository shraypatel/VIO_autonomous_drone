    def createCameraEntity(self, name: str, K: cv2.UMat, imsize: cv2.typing.Size, zFar: float, tvec: cv2.UMat | None = ..., rot: cv2.UMat | None = ..., color: cv2.typing.Scalar = ...) -> cv2.typing.Rect2d: ...

    @_typing.overload
    def createLightEntity(self, name: str, tvec: cv2.typing.MatLike | None = ..., rot: cv2.typing.MatLike | None = ..., diffuseColor: cv2.typing.Scalar = ..., specularColor: cv2.typing.Scalar = ...) -> None: ...
