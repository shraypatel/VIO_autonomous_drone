    @_typing.overload
    def setCameraLookAt(self, target: str, offset: cv2.typing.MatLike | None = ...) -> None: ...
    @_typing.overload
    def setCameraLookAt(self, target: str, offset: cv2.UMat | None = ...) -> None: ...

    @_typing.overload
    def setEntityLookAt(self, origin: str, target: str, offset: cv2.typing.MatLike | None = ...) -> None: ...
    @_typing.overload
    def setEntityLookAt(self, origin: str, target: str, offset: cv2.UMat | None = ...) -> None: ...

    @_typing.overload
    def getCameraPose(self, R: cv2.typing.MatLike | None = ..., tvec: cv2.typing.MatLike | None = ..., invert: bool = ...) -> tuple[cv2.typing.MatLike, cv2.typing.MatLike]: ...
    @_typing.overload
    def getCameraPose(self, R: cv2.UMat | None = ..., tvec: cv2.UMat | None = ..., invert: bool = ...) -> tuple[cv2.UMat, cv2.UMat]: ...

    @_typing.overload
    def setCameraIntrinsics(self, K: cv2.typing.MatLike, imsize: cv2.typing.Size, zNear: float = ..., zFar: float = ...) -> None: ...
    @_typing.overload
    def setCameraIntrinsics(self, K: cv2.UMat, imsize: cv2.typing.Size, zNear: float = ..., zFar: float = ...) -> None: ...

    def update(self) -> None: ...



