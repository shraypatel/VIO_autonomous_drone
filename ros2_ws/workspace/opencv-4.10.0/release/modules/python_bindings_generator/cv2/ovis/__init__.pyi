    def setBackgroundColor(self, color: cv2.typing.Scalar) -> None: ...

    def setCompositors(self, names: _typing.Sequence[str]) -> None: ...

    @_typing.overload
    def createEntity(self, name: str, meshname: str, tvec: cv2.typing.MatLike | None = ..., rot: cv2.typing.MatLike | None = ...) -> None: ...
