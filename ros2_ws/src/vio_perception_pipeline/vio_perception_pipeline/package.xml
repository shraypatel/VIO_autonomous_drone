<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vio_perception_pipeline</name>
  <version>0.0.0</version>
  <description>DepthAI + RTAB-Map perception pipeline with PX4 coordinate transformation</description>
  <maintainer email="shraypatel@gmail.com">group7</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <exec_depend>depthai_ros_driver</exec_depend> 
  <exec_depend>rtabmap_ros</exec_depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>image_proc</exec_depend>
  <exec_depend>esdf_msgs</exec_depend>
  <exec_depend>esdf_server</exec_depend>
  <exec_depend>rrt_star_planner</exec_depend>

  <!-- Coordinate transformer dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

</package>
